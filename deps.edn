{:paths ["src" "resources"]

 ;; datalevin is a top-level dep on purpose: in tools.deps a consumer's own
 ;; explicit :deps entry always wins over ours, so downstream projects pin
 ;; whichever Datalevin version they already run.
 :deps
 {org.clojure/clojure {:mvn/version "1.12.0"}
  datalevin/datalevin {:mvn/version "1.1.0"}
  ;; Logging facade, not a backend: as a library we emit structured logs
  ;; without forcing a logging choice on consumers. Trove defaults to *out*
  ;; and they can point it at Telemere/Timbre/SLF4J via trove/set-log-fn!.
  com.taoensso/trove {:mvn/version "1.2.0"}}

 :aliases
 {:dev
  {:extra-paths ["test"]
   :jvm-opts ["--add-opens=java.base/java.nio=ALL-UNNAMED"
              "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
              "--enable-native-access=ALL-UNNAMED"]}

  :test
  {:extra-paths ["test"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :jvm-opts ["--add-opens=java.base/java.nio=ALL-UNNAMED"
              "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
              "--enable-native-access=ALL-UNNAMED"]
   :main-opts ["-m" "cognitect.test-runner"]
   :exec-fn cognitect.test-runner.api/test}

  :build
  {:deps {io.github.clojure/tools.build {:mvn/version "0.10.5"}}
   :ns-default build}}}
